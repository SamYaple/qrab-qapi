{ 'struct': 'Backup', 'data': { 'target': 'str' } }
{ 'command': 'backup', 'boxed': true, 'data': 'Backup',
  'features': [ 'deprecated', 'unstable' ] }

{ 'command': 'flip', 'allow-preconfig': true }
{ 'command': 'quiet', 'success-response': false }
{ 'command': 'gone', 'allow-oob': true, 'features': [ 'deprecated' ] }
{ 'pragma': { 'command-returns-exceptions': [ 'query-kind' ] } }
{ 'enum': 'KindInfo', 'data': [ 'one' ] }
